table loyalty_distribution
	lineageTag: tbl-loyalty-distribution

	column loyalty_tier
		dataType: string
		summarizeBy: none
		sourceColumn: loyalty_tier
		lineageTag: col-loyalty-distribution-loyalty-tier

	column customers
		dataType: int64
		summarizeBy: sum
		sourceColumn: customers
		formatString: #,##0
		lineageTag: col-loyalty-distribution-customers

	column pct_customers
		dataType: double
		summarizeBy: average
		sourceColumn: pct_customers
		formatString: 0.0%
		lineageTag: col-loyalty-distribution-pct-customers

	column avg_clv
		dataType: double
		summarizeBy: average
		sourceColumn: avg_clv
		formatString: $#,##0
		lineageTag: col-loyalty-distribution-avg-clv

	column pct_of_clv
		dataType: double
		summarizeBy: average
		sourceColumn: pct_of_clv
		formatString: 0.0%
		lineageTag: col-loyalty-distribution-pct-of-clv

	partition loyalty_distribution = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("e:\Cagiitg\reports\sql_exports\loyalty_distribution.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(PromotedHeaders, {
			        {"loyalty_tier", type text},
			        {"customers", Int64.Type},
			        {"pct_customers", type number},
			        {"avg_clv", type number},
			        {"pct_of_clv", type number}
			    }),
			    Cleaned = Table.ReplaceErrorValues(Typed, List.Transform(Table.ColumnNames(Typed), each {_, null}))
			in
			    Cleaned
