table demographic_opportunity
	lineageTag: tbl-demographic-opportunity

	column age_band
		dataType: string
		summarizeBy: none
		sourceColumn: age_band
		lineageTag: col-demographic-opportunity-age-band

	column gender
		dataType: string
		summarizeBy: none
		sourceColumn: gender
		lineageTag: col-demographic-opportunity-gender

	column customers
		dataType: int64
		summarizeBy: sum
		sourceColumn: customers
		formatString: #,##0
		lineageTag: col-demographic-opportunity-customers

	column avg_clv
		dataType: double
		summarizeBy: average
		sourceColumn: avg_clv
		formatString: $#,##0
		lineageTag: col-demographic-opportunity-avg-clv

	column total_clv
		dataType: double
		summarizeBy: sum
		sourceColumn: total_clv
		formatString: $#,##0
		lineageTag: col-demographic-opportunity-total-clv

	column avg_loyalty
		dataType: double
		summarizeBy: average
		sourceColumn: avg_loyalty
		formatString: 0.000
		lineageTag: col-demographic-opportunity-avg-loyalty

	column avg_promo_dependency
		dataType: double
		summarizeBy: average
		sourceColumn: avg_promo_dependency
		formatString: 0.000
		lineageTag: col-demographic-opportunity-avg-promo-dependency

	column pct_satisfied
		dataType: double
		summarizeBy: average
		sourceColumn: pct_satisfied
		formatString: 0.0%
		lineageTag: col-demographic-opportunity-pct-satisfied

	column pct_premium
		dataType: double
		summarizeBy: average
		sourceColumn: pct_premium
		formatString: 0.0%
		lineageTag: col-demographic-opportunity-pct-premium

	partition demographic_opportunity = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("e:\Cagiitg\reports\sql_exports\demographic_opportunity.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(PromotedHeaders, {
			        {"age_band", type text},
			        {"gender", type text},
			        {"customers", Int64.Type},
			        {"avg_clv", type number},
			        {"total_clv", type number},
			        {"avg_loyalty", type number},
			        {"avg_promo_dependency", type number},
			        {"pct_satisfied", type number},
			        {"pct_premium", type number}
			    }),
			    Cleaned = Table.ReplaceErrorValues(Typed, List.Transform(Table.ColumnNames(Typed), each {_, null}))
			in
			    Cleaned
