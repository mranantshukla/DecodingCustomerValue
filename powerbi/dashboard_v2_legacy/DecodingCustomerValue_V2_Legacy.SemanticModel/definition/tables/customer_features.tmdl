table customer_features
	lineageTag: tbl-customer-features

	measure 'Total Customers' = DISTINCTCOUNT(customer_features[customer_id])
		formatString: #,##0
		displayFolder: "1 Core KPIs"
		lineageTag: meas-total-customers

	measure 'Total Projected CLV' = SUM(customer_features[estimated_clv_proxy])
		formatString: $#,##0
		displayFolder: "1 Core KPIs"
		lineageTag: meas-total-projected-clv

	measure 'Avg CLV per Customer' = DIVIDE([Total Projected CLV], [Total Customers])
		formatString: $#,##0
		displayFolder: "1 Core KPIs"
		lineageTag: meas-avg-clv-per-customer

	measure 'Avg Loyalty Score' = AVERAGE(customer_features[loyalty_score])
		formatString: 0.000
		displayFolder: "1 Core KPIs"
		lineageTag: meas-avg-loyalty-score

	measure 'Avg Promo Dependency' = AVERAGE(customer_features[promo_dependency_score])
		formatString: 0.000
		displayFolder: "1 Core KPIs"
		lineageTag: meas-avg-promo-dependency

	measure 'Pct Premium Customers' = DIVIDE(CALCULATE([Total Customers], customer_features[premium_customer_flag] = 1), [Total Customers])
		formatString: 0.0%
		displayFolder: "1 Core KPIs"
		lineageTag: meas-pct-premium-customers

	measure 'Pct Satisfied' = AVERAGE(customer_features[satisfaction_flag])
		formatString: 0.0%
		displayFolder: "1 Core KPIs"
		lineageTag: meas-pct-satisfied

	measure 'Pct Discounted' = DIVIDE(CALCULATE([Total Customers], customer_features[discount_applied] = "Yes"), [Total Customers])
		formatString: 0.0%
		displayFolder: "1 Core KPIs"
		lineageTag: meas-pct-discounted

	measure 'Pct Subscribed' = DIVIDE(CALCULATE([Total Customers], customer_features[subscription_status] = "Yes"), [Total Customers])
		formatString: 0.0%
		displayFolder: "1 Core KPIs"
		lineageTag: meas-pct-subscribed

	measure 'CLV Top 20 Pct' = VAR Cutoff = PERCENTILEX.INC(ALL(customer_features), customer_features[estimated_clv_proxy], 0.80) RETURN CALCULATE([Total Projected CLV], customer_features[estimated_clv_proxy] >= Cutoff)
		formatString: $#,##0
		displayFolder: "2 Concentration"
		lineageTag: meas-clv-top-20-pct

	measure 'Pct CLV from Top 20 Pct' = DIVIDE([CLV Top 20 Pct], CALCULATE([Total Projected CLV], ALL(customer_features)))
		formatString: 0.0%
		displayFolder: "2 Concentration"
		lineageTag: meas-pct-clv-from-top-20-pct

	measure 'Discounted CLV' = CALCULATE([Total Projected CLV], customer_features[discount_applied] = "Yes")
		formatString: $#,##0
		displayFolder: "3 Margin Risk"
		lineageTag: meas-discounted-clv

	measure 'Full Price CLV' = CALCULATE([Total Projected CLV], customer_features[discount_applied] = "No")
		formatString: $#,##0
		displayFolder: "3 Margin Risk"
		lineageTag: meas-full-price-clv

	measure 'Pct CLV Discount Attached' = DIVIDE([Discounted CLV], [Total Projected CLV])
		formatString: 0.0%
		displayFolder: "3 Margin Risk"
		lineageTag: meas-pct-clv-discount-attached

	measure 'Estimated Margin Recovery' = VAR MarginPts = 0.15 RETURN CALCULATE(SUMX(customer_features, customer_features[annual_value] * MarginPts), customer_features[discount_applied] = "Yes", customer_features[promo_reliance_tier] IN { "Full-Price Loyalist", "Occasional Discount" })
		formatString: $#,##0
		displayFolder: "3 Margin Risk"
		lineageTag: meas-estimated-margin-recovery

	measure 'Margin At Risk CLV' = CALCULATE([Total Projected CLV], customer_features[promo_dependency_score] >= 0.5, customer_features[loyalty_score] >= CALCULATE(AVERAGE(customer_features[loyalty_score]), ALL(customer_features)))
		formatString: $#,##0
		displayFolder: "4 Promo x Retention"
		lineageTag: meas-margin-at-risk-clv

	measure 'Avg Region Quality' = AVERAGE(customer_features[region_quality_index])
		formatString: 0.000
		displayFolder: "5 Geography"
		lineageTag: meas-avg-region-quality

	measure 'Avg Organic Demand' = AVERAGE(customer_features[organic_demand_score])
		formatString: 0.000
		displayFolder: "5 Geography"
		lineageTag: meas-avg-organic-demand

	measure 'Margin Adjusted CLV' = SUMX(customer_features, customer_features[estimated_clv_proxy] * (1 - customer_features[promo_dependency_score]))
		formatString: $#,##0
		displayFolder: "5 Geography"
		lineageTag: meas-margin-adjusted-clv

