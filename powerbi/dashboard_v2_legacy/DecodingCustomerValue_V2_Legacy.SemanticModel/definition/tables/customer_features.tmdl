	partition customer_features = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("e:\Cagiitg\data\processed\customer_features.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(PromotedHeaders, {
			        {"customer_id", Int64.Type},
			        {"age", Int64.Type},
			        {"gender", type text},
			        {"item_purchased", type text},
			        {"category", type text},
			        {"purchase_amount", type number},
			        {"location", type text},
			        {"size", type text},
			        {"color", type text},
			        {"season", type text},
			        {"review_rating", type number},
			        {"subscription_status", type text},
			        {"shipping_type", type text},
			        {"discount_applied", type text},
			        {"previous_purchases", Int64.Type},
			        {"payment_method", type text},
			        {"frequency_of_purchases", type text},
			        {"non_discount_purchase_ratio", type number},
			        {"promo_dependency_score", type number},
			        {"discount_elasticity_proxy", type number},
			        {"promo_reliance_tier", type text},
			        {"loyalty_score_v1", type number},
			        {"loyalty_score_v2", type number},
			        {"loyalty_confidence_index", type number},
			        {"repeat_purchase_intensity", type number},
			        {"brand_affinity_score", type number},
			        {"annual_value", type number},
			        {"margin_factor", type number},
			        {"economic_value_proxy", type number},
			        {"expected_tenure_years", type number},
			        {"estimated_clv_proxy", type number},
			        {"revenue_contribution_tier", type text},
			        {"high_value_probability", type number},
			        {"premium_customer_flag", Int64.Type},
			        {"satisfaction_flag", Int64.Type},
			        {"category_breadth_est", type number},
			        {"shipping_urgency_index", type number},
			        {"payment_repeat_index", type number},
			        {"seasonal_consistency_score", type number},
			        {"organic_demand_score", type number},
			        {"region_quality_index", type number},
			        {"promo_sensitivity_geo", type number},
			        {"loyalty_score", type number},
			        {"loyalty_tier", type text},
			        {"customer_persona", type text},
			        {"behaviour_cluster", type text}
			    }),
			    Cleaned = Table.ReplaceErrorValues(Typed, List.Transform(Table.ColumnNames(Typed), each {_, null}))
			in
			    Cleaned
