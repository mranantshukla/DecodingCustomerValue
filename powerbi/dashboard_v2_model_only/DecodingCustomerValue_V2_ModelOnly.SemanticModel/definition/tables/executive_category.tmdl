table executive_category
	lineageTag: tbl-executive-category

	column category
		dataType: string
		summarizeBy: none
		sourceColumn: category
		lineageTag: col-executive-category-category

	column customers
		dataType: int64
		summarizeBy: sum
		sourceColumn: customers
		formatString: #,##0
		lineageTag: col-executive-category-customers

	column total_clv
		dataType: double
		summarizeBy: sum
		sourceColumn: total_clv
		formatString: $#,##0
		lineageTag: col-executive-category-total-clv

	column avg_loyalty
		dataType: double
		summarizeBy: average
		sourceColumn: avg_loyalty
		formatString: 0.000
		lineageTag: col-executive-category-avg-loyalty

	column avg_promo_dependency
		dataType: double
		summarizeBy: average
		sourceColumn: avg_promo_dependency
		formatString: 0.000
		lineageTag: col-executive-category-avg-promo-dependency

	partition executive_category = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("e:\Cagiitg\reports\sql_exports\executive_category.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(PromotedHeaders, {
			        {"category", type text},
			        {"customers", Int64.Type},
			        {"total_clv", type number},
			        {"avg_loyalty", type number},
			        {"avg_promo_dependency", type number}
			    }),
			    Cleaned = Table.ReplaceErrorValues(Typed, List.Transform(Table.ColumnNames(Typed), each {_, null}))
			in
			    Cleaned
