table exec_kpis
	lineageTag: tbl-exec-kpis

	column total_customers
		dataType: int64
		summarizeBy: sum
		sourceColumn: total_customers
		formatString: #,##0
		lineageTag: col-exec-kpis-total-customers

	column total_projected_clv
		dataType: double
		summarizeBy: sum
		sourceColumn: total_projected_clv
		formatString: $#,##0
		lineageTag: col-exec-kpis-total-projected-clv

	column avg_clv
		dataType: double
		summarizeBy: average
		sourceColumn: avg_clv
		formatString: $#,##0
		lineageTag: col-exec-kpis-avg-clv

	column avg_loyalty
		dataType: double
		summarizeBy: average
		sourceColumn: avg_loyalty
		formatString: 0.000
		lineageTag: col-exec-kpis-avg-loyalty

	column avg_promo_dependency
		dataType: double
		summarizeBy: average
		sourceColumn: avg_promo_dependency
		formatString: 0.000
		lineageTag: col-exec-kpis-avg-promo-dependency

	column pct_discounted
		dataType: double
		summarizeBy: average
		sourceColumn: pct_discounted
		formatString: 0.0%
		lineageTag: col-exec-kpis-pct-discounted

	column pct_satisfied
		dataType: double
		summarizeBy: average
		sourceColumn: pct_satisfied
		formatString: 0.0%
		lineageTag: col-exec-kpis-pct-satisfied

	column pct_premium
		dataType: double
		summarizeBy: average
		sourceColumn: pct_premium
		formatString: 0.0%
		lineageTag: col-exec-kpis-pct-premium

	column pct_subscribed
		dataType: double
		summarizeBy: average
		sourceColumn: pct_subscribed
		formatString: 0.0%
		lineageTag: col-exec-kpis-pct-subscribed

	partition exec_kpis = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("e:\Cagiitg\reports\sql_exports\exec_kpis.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(PromotedHeaders, {
			        {"total_customers", Int64.Type},
			        {"total_projected_clv", type number},
			        {"avg_clv", type number},
			        {"avg_loyalty", type number},
			        {"avg_promo_dependency", type number},
			        {"pct_discounted", type number},
			        {"pct_satisfied", type number},
			        {"pct_premium", type number},
			        {"pct_subscribed", type number}
			    }),
			    Cleaned = Table.ReplaceErrorValues(Typed, List.Transform(Table.ColumnNames(Typed), each {_, null}))
			in
			    Cleaned
