table revenue_discount_split
	lineageTag: tbl-revenue-discount-split

	column revenue_type
		dataType: string
		summarizeBy: none
		sourceColumn: revenue_type
		lineageTag: col-revenue-discount-split-revenue-type

	column customers
		dataType: int64
		summarizeBy: sum
		sourceColumn: customers
		formatString: #,##0
		lineageTag: col-revenue-discount-split-customers

	column observed_revenue
		dataType: double
		summarizeBy: sum
		sourceColumn: observed_revenue
		formatString: $#,##0
		lineageTag: col-revenue-discount-split-observed-revenue

	column pct_observed_revenue
		dataType: double
		summarizeBy: average
		sourceColumn: pct_observed_revenue
		formatString: 0.0%
		lineageTag: col-revenue-discount-split-pct-observed-revenue

	column projected_clv
		dataType: double
		summarizeBy: sum
		sourceColumn: projected_clv
		formatString: $#,##0
		lineageTag: col-revenue-discount-split-projected-clv

	column pct_projected_clv
		dataType: double
		summarizeBy: average
		sourceColumn: pct_projected_clv
		formatString: 0.0%
		lineageTag: col-revenue-discount-split-pct-projected-clv

	partition revenue_discount_split = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("e:\Cagiitg\reports\sql_exports\revenue_discount_split.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(PromotedHeaders, {
			        {"revenue_type", type text},
			        {"customers", Int64.Type},
			        {"observed_revenue", type number},
			        {"pct_observed_revenue", type number},
			        {"projected_clv", type number},
			        {"pct_projected_clv", type number}
			    }),
			    Cleaned = Table.ReplaceErrorValues(Typed, List.Transform(Table.ColumnNames(Typed), each {_, null}))
			in
			    Cleaned
