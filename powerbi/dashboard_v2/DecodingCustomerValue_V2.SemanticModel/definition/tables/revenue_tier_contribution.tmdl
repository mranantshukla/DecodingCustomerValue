table revenue_tier_contribution
	lineageTag: tbl-revenue-tier-contribution

	column tier
		dataType: string
		summarizeBy: none
		sourceColumn: tier
		lineageTag: col-revenue-tier-contribution-tier

	column customers
		dataType: int64
		summarizeBy: sum
		sourceColumn: customers
		formatString: #,##0
		lineageTag: col-revenue-tier-contribution-customers

	column pct_customers
		dataType: double
		summarizeBy: average
		sourceColumn: pct_customers
		formatString: 0.0%
		lineageTag: col-revenue-tier-contribution-pct-customers

	column total_clv
		dataType: double
		summarizeBy: sum
		sourceColumn: total_clv
		formatString: $#,##0
		lineageTag: col-revenue-tier-contribution-total-clv

	column pct_clv
		dataType: double
		summarizeBy: average
		sourceColumn: pct_clv
		formatString: 0.0%
		lineageTag: col-revenue-tier-contribution-pct-clv

	column avg_promo_dependency
		dataType: double
		summarizeBy: average
		sourceColumn: avg_promo_dependency
		formatString: 0.000
		lineageTag: col-revenue-tier-contribution-avg-promo-dependency

	partition revenue_tier_contribution = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("e:\Cagiitg\reports\sql_exports\revenue_tier_contribution.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(PromotedHeaders, {
			        {"tier", type text},
			        {"customers", Int64.Type},
			        {"pct_customers", type number},
			        {"total_clv", type number},
			        {"pct_clv", type number},
			        {"avg_promo_dependency", type number}
			    }),
			    Cleaned = Table.ReplaceErrorValues(Typed, List.Transform(Table.ColumnNames(Typed), each {_, null}))
			in
			    Cleaned
