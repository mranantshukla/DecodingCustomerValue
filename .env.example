# ===========================================================================
# Decoding Customer Value — environment configuration
# Copy to `.env` and adjust. NEVER commit the real `.env`.
#   cp .env.example .env
# All variables are optional; sensible defaults ship in config/settings.py.
# ===========================================================================

# --- Database -----------------------------------------------------------------
# The analytics layer targets PostgreSQL in production but defaults to a local
# SQLite file so the project runs end-to-end with zero infrastructure.
#
# Leave DCV_DB_URL unset to use the bundled SQLite engine, or set a full URL:
#   SQLite (default):   sqlite:///data/processed/customer_value.db
#   PostgreSQL:         postgresql+psycopg2://user:password@localhost:5432/dcv
# DCV_DB_URL=postgresql+psycopg2://dcv_user:change_me@localhost:5432/dcv

# Granular Postgres parts (used only if DCV_DB_URL is not set and DCV_DB_BACKEND=postgres)
DCV_DB_BACKEND=sqlite
DCV_PG_HOST=localhost
DCV_PG_PORT=5432
DCV_PG_USER=dcv_user
DCV_PG_PASSWORD=change_me
DCV_PG_DATABASE=dcv

# --- Paths --------------------------------------------------------------------
# Override only if you relocate the data directories.
DCV_RAW_DATA_PATH=data/raw/Dataset.csv
DCV_PROCESSED_DIR=data/processed
DCV_REPORTS_DIR=reports

# --- Pipeline behaviour -------------------------------------------------------
DCV_LOG_LEVEL=INFO
DCV_RANDOM_SEED=42
# Fail the pipeline if any data-quality check at ERROR severity fails.
DCV_STRICT_VALIDATION=true
# Number of customer segments for KMeans value/behaviour segmentation.
DCV_N_SEGMENTS=5
