table region_scorecard
	lineageTag: tbl-region-scorecard

	column location
		dataType: string
		summarizeBy: none
		sourceColumn: location
		dataCategory: State
		lineageTag: col-region-scorecard-location

	column customers
		dataType: int64
		summarizeBy: sum
		sourceColumn: customers
		formatString: #,##0
		lineageTag: col-region-scorecard-customers

	column organic_demand
		dataType: double
		summarizeBy: average
		sourceColumn: organic_demand
		formatString: 0.000
		lineageTag: col-region-scorecard-organic-demand

	column promo_dependency
		dataType: double
		summarizeBy: average
		sourceColumn: promo_dependency
		formatString: 0.000
		lineageTag: col-region-scorecard-promo-dependency

	column region_quality
		dataType: double
		summarizeBy: average
		sourceColumn: region_quality
		formatString: 0.000
		lineageTag: col-region-scorecard-region-quality

	column avg_loyalty
		dataType: double
		summarizeBy: average
		sourceColumn: avg_loyalty
		formatString: 0.000
		lineageTag: col-region-scorecard-avg-loyalty

	column avg_satisfaction
		dataType: double
		summarizeBy: average
		sourceColumn: avg_satisfaction
		formatString: 0.0%
		lineageTag: col-region-scorecard-avg-satisfaction

	column total_clv
		dataType: double
		summarizeBy: sum
		sourceColumn: total_clv
		formatString: $#,##0
		lineageTag: col-region-scorecard-total-clv

	column avg_clv
		dataType: double
		summarizeBy: average
		sourceColumn: avg_clv
		formatString: $#,##0
		lineageTag: col-region-scorecard-avg-clv

	column promo_sensitivity
		dataType: double
		summarizeBy: average
		sourceColumn: promo_sensitivity
		formatString: 0.0000
		lineageTag: col-region-scorecard-promo-sensitivity

	partition region_scorecard = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("e:\Cagiitg\reports\sql_exports\region_scorecard.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(PromotedHeaders, {
			        {"location", type text},
			        {"customers", Int64.Type},
			        {"organic_demand", type number},
			        {"promo_dependency", type number},
			        {"region_quality", type number},
			        {"avg_loyalty", type number},
			        {"avg_satisfaction", type number},
			        {"total_clv", type number},
			        {"avg_clv", type number},
			        {"promo_sensitivity", type number}
			    }),
			    Cleaned = Table.ReplaceErrorValues(Typed, List.Transform(Table.ColumnNames(Typed), each {_, null}))
			in
			    Cleaned
