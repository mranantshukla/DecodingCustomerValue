table high_margin_regions
	lineageTag: tbl-high-margin-regions

	column location
		dataType: string
		summarizeBy: none
		sourceColumn: location
		dataCategory: State
		lineageTag: col-high-margin-regions-location

	column customers
		dataType: int64
		summarizeBy: sum
		sourceColumn: customers
		formatString: #,##0
		lineageTag: col-high-margin-regions-customers

	column avg_clv
		dataType: double
		summarizeBy: average
		sourceColumn: avg_clv
		formatString: $#,##0
		lineageTag: col-high-margin-regions-avg-clv

	column promo_dependency
		dataType: double
		summarizeBy: average
		sourceColumn: promo_dependency
		formatString: 0.000
		lineageTag: col-high-margin-regions-promo-dependency

	column margin_adjusted_clv
		dataType: double
		summarizeBy: sum
		sourceColumn: margin_adjusted_clv
		formatString: $#,##0
		lineageTag: col-high-margin-regions-margin-adjusted-clv

	partition high_margin_regions = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("e:\Cagiitg\reports\sql_exports\high_margin_regions.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(PromotedHeaders, {
			        {"location", type text},
			        {"customers", Int64.Type},
			        {"avg_clv", type number},
			        {"promo_dependency", type number},
			        {"margin_adjusted_clv", type number}
			    }),
			    Cleaned = Table.ReplaceErrorValues(Typed, List.Transform(Table.ColumnNames(Typed), each {_, null}))
			in
			    Cleaned
