table retention_driving_categories
	lineageTag: tbl-retention-driving-categories

	column category
		dataType: string
		summarizeBy: none
		sourceColumn: category
		lineageTag: col-retention-driving-categories-category

	column avg_loyalty
		dataType: double
		summarizeBy: average
		sourceColumn: avg_loyalty
		formatString: 0.000
		lineageTag: col-retention-driving-categories-avg-loyalty

	column avg_rating
		dataType: double
		summarizeBy: average
		sourceColumn: avg_rating
		formatString: 0.00
		lineageTag: col-retention-driving-categories-avg-rating

	column repeat_intensity
		dataType: double
		summarizeBy: average
		sourceColumn: repeat_intensity
		formatString: 0.000
		lineageTag: col-retention-driving-categories-repeat-intensity

	column purchases
		dataType: int64
		summarizeBy: sum
		sourceColumn: purchases
		formatString: #,##0
		lineageTag: col-retention-driving-categories-purchases

	column loyalty_rank
		dataType: int64
		summarizeBy: none
		sourceColumn: loyalty_rank
		formatString: 0
		lineageTag: col-retention-driving-categories-loyalty-rank

	partition retention_driving_categories = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("e:\Cagiitg\reports\sql_exports\retention_driving_categories.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(PromotedHeaders, {
			        {"category", type text},
			        {"avg_loyalty", type number},
			        {"avg_rating", type number},
			        {"repeat_intensity", type number},
			        {"purchases", Int64.Type},
			        {"loyalty_rank", Int64.Type}
			    }),
			    Cleaned = Table.ReplaceErrorValues(Typed, List.Transform(Table.ColumnNames(Typed), each {_, null}))
			in
			    Cleaned
