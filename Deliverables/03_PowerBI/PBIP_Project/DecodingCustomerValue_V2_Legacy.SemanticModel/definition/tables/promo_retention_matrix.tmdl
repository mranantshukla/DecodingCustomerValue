table promo_retention_matrix
	lineageTag: tbl-promo-retention-matrix

	column loyalty_band
		dataType: string
		summarizeBy: none
		sourceColumn: loyalty_band
		lineageTag: col-promo-retention-matrix-loyalty-band

	column promo_band
		dataType: string
		summarizeBy: none
		sourceColumn: promo_band
		lineageTag: col-promo-retention-matrix-promo-band

	column customers
		dataType: int64
		summarizeBy: sum
		sourceColumn: customers
		formatString: #,##0
		lineageTag: col-promo-retention-matrix-customers

	column avg_clv
		dataType: double
		summarizeBy: average
		sourceColumn: avg_clv
		formatString: $#,##0
		lineageTag: col-promo-retention-matrix-avg-clv

	column total_clv
		dataType: double
		summarizeBy: sum
		sourceColumn: total_clv
		formatString: $#,##0
		lineageTag: col-promo-retention-matrix-total-clv

	partition promo_retention_matrix = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("e:\Cagiitg\reports\sql_exports\promo_retention_matrix.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(PromotedHeaders, {
			        {"loyalty_band", type text},
			        {"promo_band", type text},
			        {"customers", Int64.Type},
			        {"avg_clv", type number},
			        {"total_clv", type number}
			    }),
			    Cleaned = Table.ReplaceErrorValues(Typed, List.Transform(Table.ColumnNames(Typed), each {_, null}))
			in
			    Cleaned
