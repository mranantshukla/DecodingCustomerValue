table entry_point_categories
	lineageTag: tbl-entry-point-categories

	column category
		dataType: string
		summarizeBy: none
		sourceColumn: category
		lineageTag: col-entry-point-categories-category

	column customers
		dataType: int64
		summarizeBy: sum
		sourceColumn: customers
		formatString: #,##0
		lineageTag: col-entry-point-categories-customers

	column new_ish_customers
		dataType: int64
		summarizeBy: sum
		sourceColumn: new_ish_customers
		formatString: #,##0
		lineageTag: col-entry-point-categories-new-ish-customers

	column pct_low_history
		dataType: double
		summarizeBy: average
		sourceColumn: pct_low_history
		formatString: 0.0%
		lineageTag: col-entry-point-categories-pct-low-history

	column avg_basket
		dataType: double
		summarizeBy: average
		sourceColumn: avg_basket
		formatString: $#,##0.00
		lineageTag: col-entry-point-categories-avg-basket

	partition entry_point_categories = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("e:\Cagiitg\reports\sql_exports\entry_point_categories.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(PromotedHeaders, {
			        {"category", type text},
			        {"customers", Int64.Type},
			        {"new_ish_customers", Int64.Type},
			        {"pct_low_history", type number},
			        {"avg_basket", type number}
			    }),
			    Cleaned = Table.ReplaceErrorValues(Typed, List.Transform(Table.ColumnNames(Typed), each {_, null}))
			in
			    Cleaned
