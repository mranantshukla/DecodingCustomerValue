table high_loyalty_products
	lineageTag: tbl-high-loyalty-products

	column item_purchased
		dataType: string
		summarizeBy: none
		sourceColumn: item_purchased
		lineageTag: col-high-loyalty-products-item-purchased

	column category
		dataType: string
		summarizeBy: none
		sourceColumn: category
		lineageTag: col-high-loyalty-products-category

	column purchases
		dataType: int64
		summarizeBy: sum
		sourceColumn: purchases
		formatString: #,##0
		lineageTag: col-high-loyalty-products-purchases

	column avg_loyalty
		dataType: double
		summarizeBy: average
		sourceColumn: avg_loyalty
		formatString: 0.000
		lineageTag: col-high-loyalty-products-avg-loyalty

	column avg_rating
		dataType: double
		summarizeBy: average
		sourceColumn: avg_rating
		formatString: 0.00
		lineageTag: col-high-loyalty-products-avg-rating

	column avg_clv
		dataType: double
		summarizeBy: average
		sourceColumn: avg_clv
		formatString: $#,##0
		lineageTag: col-high-loyalty-products-avg-clv

	partition high_loyalty_products = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("e:\Cagiitg\reports\sql_exports\high_loyalty_products.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(PromotedHeaders, {
			        {"item_purchased", type text},
			        {"category", type text},
			        {"purchases", Int64.Type},
			        {"avg_loyalty", type number},
			        {"avg_rating", type number},
			        {"avg_clv", type number}
			    }),
			    Cleaned = Table.ReplaceErrorValues(Typed, List.Transform(Table.ColumnNames(Typed), each {_, null}))
			in
			    Cleaned
