table promo_heavy_regions
	lineageTag: tbl-promo-heavy-regions

	column location
		dataType: string
		summarizeBy: none
		sourceColumn: location
		dataCategory: State
		lineageTag: col-promo-heavy-regions-location

	column customers
		dataType: int64
		summarizeBy: sum
		sourceColumn: customers
		formatString: #,##0
		lineageTag: col-promo-heavy-regions-customers

	column promo_dependency
		dataType: double
		summarizeBy: average
		sourceColumn: promo_dependency
		formatString: 0.000
		lineageTag: col-promo-heavy-regions-promo-dependency

	column organic_demand
		dataType: double
		summarizeBy: average
		sourceColumn: organic_demand
		formatString: 0.000
		lineageTag: col-promo-heavy-regions-organic-demand

	column promo_sensitivity
		dataType: double
		summarizeBy: average
		sourceColumn: promo_sensitivity
		formatString: 0.0000
		lineageTag: col-promo-heavy-regions-promo-sensitivity

	column total_clv
		dataType: double
		summarizeBy: sum
		sourceColumn: total_clv
		formatString: $#,##0
		lineageTag: col-promo-heavy-regions-total-clv

	partition promo_heavy_regions = m
		mode: import
		source =
			let
			    Source = Csv.Document(File.Contents("e:\Cagiitg\reports\sql_exports\promo_heavy_regions.csv"),[Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
			    PromotedHeaders = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
			    Typed = Table.TransformColumnTypes(PromotedHeaders, {
			        {"location", type text},
			        {"customers", Int64.Type},
			        {"promo_dependency", type number},
			        {"organic_demand", type number},
			        {"promo_sensitivity", type number},
			        {"total_clv", type number}
			    }),
			    Cleaned = Table.ReplaceErrorValues(Typed, List.Transform(Table.ColumnNames(Typed), each {_, null}))
			in
			    Cleaned
